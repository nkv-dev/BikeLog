---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Rides" activePage="rides">
  <div class="mx-auto max-w-lg px-4 py-4">
    <div class="mb-4 flex items-center justify-between">
      <div>
        <h1 class="text-xl font-bold tracking-tight">Ride Log</h1>
        <p class="k-label mt-0.5">Trips & kilometres</p>
      </div>
      <button id="add-ride-btn" class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-3 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 active:scale-[0.97]">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        Add Ride
      </button>
    </div>

    <div id="no-bike-msg" class="hidden rounded-xl border border-border bg-card p-8 text-center">
      <p class="text-sm text-muted-foreground">Select a bike first to view rides.</p>
      <a href="/bikes" class="mt-2 inline-block text-sm font-medium text-primary hover:underline">Add a bike</a>
    </div>

    <div id="rides-list" class="space-y-3" aria-live="polite"></div>
  </div>

  <div id="ride-dialog" class="fixed inset-0 z-[80] hidden" role="dialog" aria-modal="true" aria-labelledby="ride-dialog-title" tabindex="-1">
    <div class="fixed inset-0 bg-black/50" id="ride-dialog-overlay"></div>
    <div class="fixed inset-x-0 bottom-0 z-50 max-h-[90vh] overflow-y-auto rounded-t-2xl border-t border-border bg-background p-6 shadow-lg">
      <div class="mx-auto max-w-lg">
        <div class="mb-4 flex items-center justify-between">
          <h2 id="ride-dialog-title" class="text-lg font-bold">Log Ride</h2>
          <button id="close-ride-dialog" aria-label="Close dialog" class="rounded-lg p-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>

        <form id="ride-form" class="space-y-4">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="ride-date" class="mb-1 block text-sm font-medium">Date</label>
              <input type="date" id="ride-date" required class="w-full rounded-lg border border-input bg-background px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
            </div>
            <div>
              <label for="ride-distance" class="mb-1 block text-sm font-medium">Distance (km)</label>
              <input type="number" id="ride-distance" required min="0" step="0.1" placeholder="120" class="w-full rounded-lg border border-input bg-background px-3 py-2.5 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
            </div>
          </div>
          <div>
            <label for="ride-route" class="mb-1 block text-sm font-medium">Route</label>
            <input type="text" id="ride-route" required placeholder="Bangalore → Mysore → Bangalore" class="w-full rounded-lg border border-input bg-background px-3 py-2.5 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="ride-odo" class="mb-1 block text-sm font-medium">Odometer at start (km)</label>
              <input type="number" id="ride-odo" min="0" placeholder="41250" class="w-full rounded-lg border border-input bg-background px-3 py-2.5 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
            </div>
            <div>
              <label for="ride-speed" class="mb-1 block text-sm font-medium">Avg speed (km/h)</label>
              <input type="number" id="ride-speed" min="0" step="0.1" placeholder="65" class="w-full rounded-lg border border-input bg-background px-3 py-2.5 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
            </div>
          </div>
          <div>
            <label for="ride-notes" class="mb-1 block text-sm font-medium">Notes (optional)</label>
            <textarea id="ride-notes" rows="2" placeholder="Weather, group ride, fuel stops..." class="w-full rounded-lg border border-input bg-background px-3 py-2.5 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
          </div>
          <button type="submit" class="w-full rounded-lg bg-primary py-3 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
            Save Ride
          </button>
        </form>
      </div>
    </div>
  </div>

  <script>
    import { bikeStore, rideStore, settingsStore } from "@/lib/store";
    import { generateId, formatOdometer, formatDate } from "@/lib/indian-utils";
    import { showToast, confirmDialog } from "@/lib/toast";

    function getActiveBikeId(): string | null {
      return settingsStore.get().activeBikeId;
    }

    function renderEntries() {
      const bikeId = getActiveBikeId();
      const list = document.getElementById("rides-list");
      const noBikeMsg = document.getElementById("no-bike-msg");
      const addBtn = document.getElementById("add-ride-btn");

      if (!bikeId) {
        list!.classList.add("hidden");
        noBikeMsg!.classList.remove("hidden");
        addBtn!.classList.add("hidden");
        return;
      }

      list!.classList.remove("hidden");
      noBikeMsg!.classList.add("hidden");
      addBtn!.classList.remove("hidden");

      const entries = rideStore.getByBike(bikeId).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

      if (entries.length === 0) {
        list!.innerHTML = `<div class="rounded-xl border border-border bg-card p-8 text-center"><p class="text-sm text-muted-foreground">No rides logged yet. Tap <strong>Add Ride</strong> to log your first trip.</p></div>`;
        return;
      }

      const totalKm = entries.reduce((s, r) => s + (r.distanceKm || 0), 0);

      list!.innerHTML = `
        <div class="grid grid-cols-3 gap-3">
          <div class="rounded-xl bg-surface-sunken p-3 text-center">
            <p class="k-label">Rides</p>
            <p class="k-stat mt-0.5 text-xl font-bold text-card-foreground">${entries.length}</p>
          </div>
          <div class="rounded-xl bg-surface-sunken p-3 text-center">
            <p class="k-label">Total km</p>
            <p class="k-stat mt-0.5 text-xl font-bold text-card-foreground">${Math.round(totalKm).toLocaleString("en-IN")}</p>
          </div>
          <div class="rounded-xl bg-surface-sunken p-3 text-center">
            <p class="k-label">Avg km</p>
            <p class="k-stat mt-0.5 text-xl font-bold text-card-foreground">${Math.round(totalKm / entries.length).toLocaleString("en-IN")}</p>
          </div>
        </div>
        <div class="mt-3 space-y-3">
        ${entries
          .map(
            (e) => `
        <div class="k-entry">
          <div class="k-entry-row">
            <div class="flex min-w-0 items-start gap-3">
              <span class="k-entry-dot bg-purple-500" aria-hidden="true"></span>
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center rounded-full bg-purple-100 px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wide text-purple-800 dark:bg-purple-900 dark:text-purple-300">${e.distanceKm} km</span>
                  <p class="k-entry-mono">${formatDate(e.date)}</p>
                </div>
                <p class="k-entry-title mt-1 truncate">${e.route}</p>
                ${e.odometer ? `<p class="k-entry-mono mt-0.5">Start ${formatOdometer(e.odometer)}</p>` : ""}
                ${e.avgSpeedKmh ? `<p class="k-entry-sub mt-0.5">Avg ${e.avgSpeedKmh} km/h</p>` : ""}
                ${e.notes ? `<p class="k-entry-sub mt-0.5">${e.notes}</p>` : ""}
              </div>
            </div>
            <div class="flex shrink-0 items-start gap-1">
              <button onclick="deleteRide('${e.id}')" aria-label="Delete this ride" class="rounded-lg p-2 text-muted-foreground transition-colors hover:bg-destructive/10 hover:text-destructive active:scale-95">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              </button>
            </div>
          </div>
        </div>`
          )
          .join("")}
        </div>`;
    }

    const dialog = document.getElementById("ride-dialog")!;
    const overlay = document.getElementById("ride-dialog-overlay")!;
    const form = document.getElementById("ride-form") as HTMLFormElement;
    let lastFocused: HTMLElement | null = null;

    function openDialog() {
      const bikeId = getActiveBikeId();
      if (!bikeId) {
        showToast("Please add and select a bike first.", "error");
        window.location.href = "/bikes";
        return;
      }
      lastFocused = document.activeElement as HTMLElement;
      dialog.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      (document.getElementById("ride-date") as HTMLInputElement).value = new Date().toISOString().split("T")[0];
      (document.getElementById("ride-date") as HTMLInputElement).focus();
    }

    function closeDialog() {
      dialog.classList.add("hidden");
      document.body.style.overflow = "";
      form.reset();
      if (lastFocused) lastFocused.focus();
    }

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !dialog.classList.contains("hidden")) {
        e.preventDefault();
        closeDialog();
      }
    });

    document.getElementById("add-ride-btn")!.onclick = openDialog;
    document.getElementById("close-ride-dialog")!.onclick = closeDialog;
    overlay.onclick = closeDialog;

    form.onsubmit = (e) => {
      e.preventDefault();
      const bikeId = getActiveBikeId();
      if (!bikeId) {
        showToast("Please select a bike first.", "error");
        return;
      }

      const distanceKm = parseFloat((document.getElementById("ride-distance") as HTMLInputElement).value);
      const odometer = parseInt((document.getElementById("ride-odo") as HTMLInputElement).value) || undefined;

      const entry = {
        id: generateId(),
        bikeId,
        date: (document.getElementById("ride-date") as HTMLInputElement).value,
        route: (document.getElementById("ride-route") as HTMLInputElement).value,
        distanceKm,
        odometer,
        avgSpeedKmh: parseFloat((document.getElementById("ride-speed") as HTMLInputElement).value) || undefined,
        notes: (document.getElementById("ride-notes") as HTMLTextAreaElement).value || undefined,
      };

      rideStore.add(entry);

      const bike = bikeStore.getById(bikeId);
      if (bike && odometer && odometer > bike.odometer) {
        bikeStore.update(bikeId, { odometer });
      }

      closeDialog();
      renderEntries();
      showToast("Ride saved");
    };

    (window as any).deleteRide = (id: string) => {
      confirmDialog("Delete this ride?", () => {
        rideStore.remove(id);
        renderEntries();
        showToast("Ride deleted", "info");
      });
    };

    renderEntries();
  </script>
</BaseLayout>