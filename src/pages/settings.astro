---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ThemeToggle } from "@/components/starwind/theme-toggle";
---

<BaseLayout title="Settings" activePage="">
  <div class="mx-auto max-w-lg px-4 py-4">
    <h1 class="mb-4 text-xl font-bold">Settings</h1>

    <div class="space-y-4">
      <div class="rounded-xl border border-border bg-card p-4">
        <h2 class="mb-3 text-sm font-semibold">Appearance</h2>
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium">Dark Mode</p>
            <p class="text-xs text-muted-foreground">Toggle light/dark theme</p>
          </div>
          <ThemeToggle />
        </div>
        <div class="mt-4 border-t border-border pt-4">
          <p class="text-sm font-medium">Bike Theme</p>
          <p class="mb-3 text-xs text-muted-foreground">Pick an accent color, or let it follow your active bike's brand.</p>
          <div id="accent-picker" class="flex flex-wrap gap-2" role="group" aria-label="Bike theme accent color"></div>
        </div>
      </div>

      <div class="rounded-xl border border-border bg-card p-4">
        <h2 class="mb-3 text-sm font-semibold">Data Management</h2>
        <div class="space-y-3">
          <button id="export-btn" class="flex w-full items-center gap-3 rounded-lg border border-border p-3 text-left transition-colors hover:bg-muted">
            <div class="rounded-lg bg-green-500/10 p-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium">Export Data</p>
              <p class="text-xs text-muted-foreground">Download all data as JSON file</p>
            </div>
          </button>

          <button id="import-btn" class="flex w-full items-center gap-3 rounded-lg border border-border p-3 text-left transition-colors hover:bg-muted">
            <div class="rounded-lg bg-blue-500/10 p-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium">Import Data</p>
              <p class="text-xs text-muted-foreground">Restore data from a JSON file</p>
            </div>
          </button>

          <button id="clear-btn" class="flex w-full items-center gap-3 rounded-lg border border-destructive/30 p-3 text-left transition-colors hover:bg-destructive/5">
            <div class="rounded-lg bg-destructive/10 p-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-destructive">
                <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-destructive">Clear All Data</p>
              <p class="text-xs text-muted-foreground">Permanently delete all entries</p>
            </div>
          </button>
        </div>
      </div>

      <div class="rounded-xl border border-border bg-card p-4">
        <h2 class="mb-3 text-sm font-semibold">About</h2>
        <div class="space-y-2">
          <div class="flex justify-between text-sm">
            <span class="text-muted-foreground">Version</span>
            <span>1.0.0</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-muted-foreground">Built with</span>
            <span>Astro + Starwind UI</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-muted-foreground">Deployed on</span>
            <span>Cloudflare Pages</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <input type="file" id="import-file" accept=".json" class="hidden" />

  <script>
    import { exportAllData, importAllData, settingsStore } from "@/lib/store";
    import { showToast, confirmDialog } from "@/lib/toast";
    import { ACCENT_THEME_OPTIONS } from "@/lib/brand-themes";

    function currentAccent(): string {
      return settingsStore.get().accentTheme ?? "auto";
    }

    function renderAccentPicker() {
      const container = document.getElementById("accent-picker")!;
      const selected = currentAccent();
      container.innerHTML = ACCENT_THEME_OPTIONS.map((opt) => {
        const swatch = opt.swatch
          ? `<span class="inline-block size-4 rounded-full border border-black/10" style="background:${opt.swatch}"></span>`
          : `<span class="inline-block size-4 rounded-full border border-border bg-gradient-to-br from-indigo-400 to-pink-400"></span>`;
        return `<button type="button" data-accent="${opt.value}" aria-pressed="${opt.value === selected}"
          class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-medium transition-colors ${
            opt.value === selected
              ? "border-primary bg-primary/10 text-primary"
              : "border-border text-muted-foreground hover:bg-muted"
          }">${swatch}<span>${opt.label}</span></button>`;
      }).join("");
      container.querySelectorAll("[data-accent]").forEach((btn) => {
        btn.addEventListener("click", () => selectAccent(btn.getAttribute("data-accent")!));
      });
    }

    function selectAccent(value: string) {
      settingsStore.update({ accentTheme: value });
      renderAccentPicker();
      document.dispatchEvent(new Event("bikelog:accent-theme-changed"));
      showToast("Bike theme updated");
    }

    renderAccentPicker();

    document.getElementById("export-btn")!.onclick = () => {
      const data = exportAllData();
      const blob = new Blob([data], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `bikelog-backup-${new Date().toISOString().split("T")[0]}.json`;
      a.click();
      URL.revokeObjectURL(url);
      showToast("Backup downloaded", "success");
    };

    document.getElementById("import-btn")!.onclick = () => {
      document.getElementById("import-file")!.click();
    };

    document.getElementById("import-file")!.addEventListener("change", (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        const success = importAllData(reader.result as string);
        if (success) {
          showToast("Data imported successfully");
          window.dispatchEvent(new Event("bikelog:data-changed"));
          document.dispatchEvent(new Event("bikelog:bikes-changed"));
          location.reload();
        } else {
          showToast("Failed to import. Please check the file format.", "error");
        }
      };
      reader.readAsText(file);
      (e.target as HTMLInputElement).value = "";
    });

    document.getElementById("clear-btn")!.onclick = () => {
      confirmDialog("This will permanently delete ALL bikes, fuel, service, and issue data.", () => {
        localStorage.removeItem("bikelog_bikes");
        localStorage.removeItem("bikelog_fuel");
        localStorage.removeItem("bikelog_service");
        localStorage.removeItem("bikelog_issues");
        localStorage.removeItem("bikelog_settings");
        showToast("All data cleared", "info");
        location.reload();
      });
    };
  </script>
</BaseLayout>
