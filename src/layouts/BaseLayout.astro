---
import { ThemeToggle } from "@/components/starwind/theme-toggle";
import { ThemeInitScript } from "@starwind-ui/astro/theme";
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/jetbrains-mono";
import "@/styles/starwind.css";

interface Props {
  title: string;
  activePage?: string;
}

const { title, activePage = "home" } = Astro.props;

const navItems = [
  { id: "home", label: "Home", href: "/", icon: "home" },
  { id: "fuel", label: "Fuel", href: "/fuel", icon: "fuel" },
  { id: "service", label: "Service", href: "/service", icon: "wrench" },
  { id: "rides", label: "Rides", href: "/rides", icon: "route" },
  { id: "mods", label: "Mods", href: "/mods", icon: "wrench-alt" },
  { id: "checklists", label: "Checks", href: "/checklists", icon: "checklist" },
  { id: "bikes", label: "Bikes", href: "/bikes", icon: "bike" },
];

const icons: Record<string, string> = {
  home: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  fuel: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 22V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v17"/><path d="M15 10h2a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2v0a2 2 0 0 0 2-2V9l-3-3"/><path d="M3 22h12"/><rect x="6" y="7" width="6" height="4" rx="1"/></svg>`,
  wrench: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
  "wrench-alt": `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 6a2 2 0 1 1 4 0 2 2 0 0 1-4 0"/><path d="M18 6v6"/><path d="M12 22V8a4 4 0 0 1 4-4"/><path d="M12 22H7"/><path d="M7 22v-9a2 2 0 0 1 2-2h3"/></svg>`,
  route: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/></svg>`,
  checklist: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6h11"/><path d="M9 12h11"/><path d="M9 18h11"/><path d="m3 6 1 1 2-2"/><path d="m3 12 1 1 2-2"/><path d="m3 18 1 1 2-2"/></svg>`,
  bike: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3.5-3.5 2-3 2 3h3"/></svg>`,
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#18181b" />
    <script is:inline>
      document.documentElement.classList.replace("no-js", "js");
    </script>
    <script is:inline>
      (function () {
        var meta = document.querySelector('meta[name="theme-color"]');
        var apply = function () {
          if (!meta) return;
          var dark = document.documentElement.classList.contains("dark");
          meta.setAttribute("content", dark ? "#18181b" : "#ffffff");
        };
        apply();
        var observer = new MutationObserver(apply);
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
        window.addEventListener("astro:after-swap", apply);
      })();
    </script>
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="description" content="Track your bike's mileage, fuel, servicing and repairs" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        function normalize(brand) {
          var key = String(brand || "").trim().toLowerCase().replace(/[^a-z0-9]+/g, "-");
          var map = { royalenfield: "royal-enfield", harleydavidson: "harley-davidson", harley: "harley-davidson", cfdmoto: "cfmoto" };
          if (map[key]) return map[key];
          return key;
        }
        function applyAccent() {
          var html = document.documentElement;
          try {
            var settings = JSON.parse(localStorage.getItem("bikelog_settings") || "{}");
            var accent = settings.accentTheme || "auto";
            var resolved = "default";
            if (accent === "auto") {
              var bikes = JSON.parse(localStorage.getItem("bikelog_bikes") || "[]");
              var bike = bikes.find(function (b) { return b.id === settings.activeBikeId; });
              resolved = bike ? normalize(bike.brand) : "default";
            } else if (accent !== "default") {
              resolved = accent;
            }
            if (resolved === "default") html.removeAttribute("data-theme");
            else html.setAttribute("data-theme", resolved);
          } catch (e) {
            html.removeAttribute("data-theme");
          }
        }
        applyAccent();
        window.addEventListener("astro:after-swap", applyAccent);
      })();
    </script>
    <ThemeInitScript />
    <title>{title} | BikeLog</title>
    <style>
      html, body {
        height: 100%;
        overscroll-behavior: none;
      }
      body {
        display: flex;
        flex-direction: column;
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
      .page-content {
        flex: 1;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
      }
    </style>
  </head>
  <body class="bg-background text-foreground min-h-screen">
    <header class="sticky top-0 z-40 flex items-center justify-between border-b border-border bg-background/95 px-4 py-3 backdrop-blur supports-[backdrop-filter]:bg-background/60">
      <div class="flex items-center gap-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true">
          <circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3.5-3.5 2-3 2 3h3"/>
        </svg>
        <div class="flex flex-col leading-none">
          <h1 class="text-lg font-bold tracking-tight">BikeLog</h1>
          <span class="k-label-aloud mt-0.5 hidden sm:inline">Mileage ledger</span>
        </div>
      </div>
      <div id="bike-selector-container" class="flex items-center gap-2">
        <span class="hidden text-sm text-muted-foreground sm:inline" id="active-bike-name" aria-live="polite">No bike selected</span>
        <button id="header-push-btn" type="button" aria-label="Push data to GitHub" title="Push data to GitHub"
          class="flex h-10 w-10 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground active:scale-95 disabled:pointer-events-none disabled:opacity-60">
          <svg xmlns="http://www.w3.org/2000/svg" id="header-push-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14"/><path d="m19 12-7-7-7 7"/>
          </svg>
        </button>
        <button id="header-pull-btn" type="button" aria-label="Pull data from GitHub" title="Pull data from GitHub"
          class="flex h-10 w-10 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground active:scale-95 disabled:pointer-events-none disabled:opacity-60">
          <svg xmlns="http://www.w3.org/2000/svg" id="header-pull-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14"/><path d="m19 12-7 7-7-7"/>
          </svg>
        </button>
        <a href="/settings" aria-label="Settings" class="flex h-10 w-10 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground active:scale-95">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>
          </svg>
        </a>
      </div>
    </header>

    <main class="page-content pb-20">
      <slot />
    </main>

    <nav class="fixed bottom-0 left-0 right-0 z-50 border-t border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60" style="padding-bottom: env(safe-area-inset-bottom, 0px);">
      <div class="mx-auto flex max-w-lg items-center justify-around py-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "flex min-h-[48px] min-w-[48px] flex-col items-center justify-center gap-0.5 rounded-lg px-2 text-xs font-medium transition-colors active:scale-95",
              activePage === item.id
                ? "text-primary"
                : "text-muted-foreground hover:text-foreground",
            ]}
            aria-label={item.label}
            aria-current={activePage === item.id ? "page" : undefined}
          >
            <span class:list={["flex h-6 w-6 items-center justify-center", activePage === item.id && "text-primary"]}>
              <Fragment set:html={icons[item.icon]} aria-hidden="true" />
            </span>
            <span>{item.label}</span>
          </a>
        ))}
      </div>
    </nav>

    <script>
      import { sync, github } from "@/lib/sync-client";

      // ---- GitHub push/pull buttons + auto-sync ----
      const pushBtn = document.getElementById("header-push-btn") as HTMLButtonElement | null;
      const pullBtn = document.getElementById("header-pull-btn") as HTMLButtonElement | null;
      const pushIcon = document.getElementById("header-push-icon") as HTMLElement | null;
      const pullIcon = document.getElementById("header-pull-icon") as HTMLElement | null;
      let connected = false;
      let pushing = false;
      let pushTimer: ReturnType<typeof setTimeout> | null = null;

      function updateSyncButtons() {
        [pushBtn, pullBtn].forEach((btn) => {
          if (!btn) return;
          if (!connected) {
            btn.disabled = true;
            btn.title = "Connect GitHub in Settings to enable syncing";
          } else {
            btn.disabled = pushing;
          }
        });
      }

      function setPushing(on: boolean) {
        pushing = on;
        [pushIcon, pullIcon].forEach((icon) => {
          if (!icon) return;
          if (on) icon.classList.add("animate-spin");
          else icon.classList.remove("animate-spin");
        });
        updateSyncButtons();
      }

      async function runSync(action: () => Promise<void>) {
        if (!connected || pushing) return;
        setPushing(true);
        try {
          await action();
        } catch (e) {
          console.error("sync failed", e);
          [pushBtn, pullBtn].forEach((btn) => {
            btn?.classList.remove("text-primary");
            btn?.classList.add("text-destructive");
            setTimeout(() => btn?.classList.remove("text-destructive"), 1600);
          });
        } finally {
          setPushing(false);
        }
      }

      pushBtn?.addEventListener("click", () => runSync(() => sync.push()));
      pullBtn?.addEventListener("click", () =>
        runSync(async () => {
          await sync.pull();
          window.dispatchEvent(new Event("bikelog:data-changed"));
        })
      );

      // Auto-sync: debounce a push after any local data change (5s quiet period).
      document.addEventListener("bikelog:data-changed", () => {
        if (!connected) return;
        clearTimeout(pushTimer as ReturnType<typeof setTimeout> | undefined);
        pushTimer = setTimeout(() => runSync(() => sync.push()), 5000);
      });

      checkConnection();

      async function checkConnection() {
        try {
          const me = await github.me();
          connected = me.connected;
        } catch {
          connected = false;
        }
        updateSyncButton();
      }

      function normalizeBrand(brand: string): string {
        const key = String(brand || "").trim().toLowerCase().replace(/[^a-z0-9]+/g, "-");
        const map: Record<string, string> = {
          royalenfield: "royal-enfield",
          harleydavidson: "harley-davidson",
          harley: "harley-davidson",
          cfdmoto: "cfmoto",
        };
        return map[key] || key;
      }

      function applyAccentTheme() {
        const html = document.documentElement;
        try {
          const settings = JSON.parse(localStorage.getItem("bikelog_settings") || "{}");
          const accent = settings.accentTheme || "auto";
          let resolved = "default";
          if (accent === "auto") {
            const bikes = JSON.parse(localStorage.getItem("bikelog_bikes") || "[]");
            const bike = bikes.find((b: any) => b.id === settings.activeBikeId);
            resolved = bike ? normalizeBrand(bike.brand) : "default";
          } else if (accent !== "default") {
            resolved = accent;
          }
          if (resolved === "default") html.removeAttribute("data-theme");
          else html.setAttribute("data-theme", resolved);
        } catch {
          html.removeAttribute("data-theme");
        }
      }

      function updateActiveBikeDisplay() {
        try {
          const settings = JSON.parse(localStorage.getItem("bikelog_settings") || "{}");
          const bikes = JSON.parse(localStorage.getItem("bikelog_bikes") || "[]");
          const el = document.getElementById("active-bike-name");
          if (settings.activeBikeId && el) {
            const bike = bikes.find((b: any) => b.id === settings.activeBikeId);
            if (bike) el.textContent = bike.name;
          }
        } catch {}
        applyAccentTheme();
      }
      updateActiveBikeDisplay();
      window.addEventListener("storage", updateActiveBikeDisplay);
      document.addEventListener("bikelog:bikes-changed", updateActiveBikeDisplay);
      document.addEventListener("bikelog:accent-theme-changed", applyAccentTheme);
    </script>
  </body>
</html>
