{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bikelog",
  "compatibility_date": "2026-01-01",
  "observability": {
    "enabled": true
  },
  // KV namespaces (self-hosted single user, but kept generic).
  // Create them:
  //   wrangler kv namespace create BIKE_TOKENS
  //   wrangler kv namespace create BIKE_SESSIONS
  // then paste the returned ids.
  "kv_namespaces": [
    {
      "binding": "BIKE_TOKENS",
      "id": "f3d730c53265470897adaf0e23559f4c"
    },
    {
      "binding": "BIKE_SESSIONS",
      "id": "2e471e66d01e46b9a93149421c0cdb21"
    }
  ],
  // Non-secret GitHub App configuration (safe to commit).
  "vars": {
    "GITHUB_CLIENT_ID": "Iv23linWQBtIvSrHoB45",
    "GITHUB_APP_ID": "4867398",
    "GITHUB_REPO_NAME": "bikelog",
    "PUBLIC_SITE_URL": "http://localhost:4321"
  },
  // Store these secrets with `wrangler secret put` (never commit):
  //   GITHUB_CLIENT_SECRET   - GitHub App client secret
  //   GITHUB_PRIVATE_KEY     - GitHub App private key (PEM)
  //   GITHUB_WEBHOOK_SECRET  - (optional) webhook secret
}
